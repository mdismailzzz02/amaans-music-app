# Environment Variables Template
# Copy this file to .env.local and fill in your credentials

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────
# Cloudflare R2
# ─────────────────────────────────────────────
# Found in Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Public base URL for your R2 bucket (if public access is enabled)
# e.g. https://pub-xxxx.r2.dev  OR  https://cdn.yourdomain.com
# Leave blank to use signed URLs only (recommended for private files)
R2_PUBLIC_URL=
